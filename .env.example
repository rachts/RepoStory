# Optional GitHub token for higher public API rate limits.
# Never commit a real token.
GITHUB_TOKEN=

# Analysis result and job-store limits.
REPO_STORY_MAX_ANALYSES=100
REPO_STORY_ANALYSIS_TTL_MS=3600000
# Use supabase in production after applying supabase/migrations/001_repo_story.sql.
REPO_STORY_JOB_STORE=file
REPO_STORY_JOB_STORE_PATH=.repo-story-data/state.json
# The file store requires a writable, persistent directory in production.
# Use a database-backed adapter for multi-instance/serverless deployments.
REPO_STORY_JOB_TTL_MS=3600000
REPO_STORY_MAX_CONCURRENT_JOBS=2
REPO_STORY_MAX_JOB_RETRIES=2
REPO_STORY_JOB_RETRY_BACKOFF_MS=250
REPO_STORY_ANALYZER_VERSION=phase-async-1
REPO_STORY_CONFIG_VERSION=1

# Server-only Supabase credentials for the production job store.
# Never expose SUPABASE_SECRET_KEY through NEXT_PUBLIC_* or commit a real key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional server-side Groq explanation layer. Never expose or commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_INPUT_CHARS=60000
GROQ_ENABLED=true
