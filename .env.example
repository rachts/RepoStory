# ==============================================================================
# RepoStory Environment Configuration Template
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub Integration & Token Pool
# ------------------------------------------------------------------------------
# Single token fallback (optional for anonymous public access)
GITHUB_TOKEN=

# Token pool: comma-separated list of GitHub Personal Access Tokens.
# When provided, requests are routed to the token with the highest remaining rate-limit quota.
GITHUB_TOKENS=

# Bounded concurrency for fetching file contents in parallel (default: 6)
MAX_CONCURRENT_GITHUB_CONTENT_REQUESTS=6

# Hard ceiling for Git tree entries before rejecting the repository as oversized (default: 100000)
MAX_TREE_ENTRIES_CEILING=100000
# Maximum analysis execution budget before timing out in milliseconds (default: 60000)
# REPO_STORY_MAX_ANALYSIS_MS=60000

# ------------------------------------------------------------------------------
# 2. Authentication & Quotas (NextAuth / Auth.js)
# ------------------------------------------------------------------------------
# Canonical application URL
NEXTAUTH_URL=http://localhost:3000

# Random 32+ character secret for JWT/session encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# GitHub OAuth App credentials (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Feature flag: Allow anonymous analysis without signing in (default: true in dev, false in prod)
ANONYMOUS_ANALYSIS_ENABLED=true

# Daily UTC quota of repository analyses per user (default: 5)
ANALYSIS_DAILY_QUOTA=5

# ------------------------------------------------------------------------------
# 3. Persistence & Durable Job Queue (Supabase / In-Memory)
# ------------------------------------------------------------------------------
# Set to 'supabase' for production deployments, 'file' or 'memory' for dev/tests.
REPO_STORY_JOB_STORE=memory
REPO_STORY_JOB_STORE_PATH=.repo-story-data/state.json

# Server-only Supabase service credentials (from Supabase Project Settings -> API)
# Required in production when REPO_STORY_JOB_STORE=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Dev/Test guards: Set to 'true' to explicitly allow in-memory adapters when NODE_ENV=production
ALLOW_IN_MEMORY_QUEUE=false
ALLOW_IN_MEMORY_STORE=false

# Worker process identifier (defaults to worker-<pid>)
WORKER_ID=
WORKER_HEARTBEAT_TIMEOUT_MS=120000
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# 4. Inbound Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
# Optional Upstash Redis credentials for distributed sliding-window rate limiting on POST /api/analyze.
# If omitted, an in-memory sliding window limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 5. File Handling & Memory Budgets
# ------------------------------------------------------------------------------
# Git LFS: enable fetching targets for LFS pointer files (default: false)
FETCH_LFS=false
# Maximum size in bytes for an individual LFS file (default: 5242880 / 5MB)
MAX_LFS_BYTES=5242880

# Git submodules: maximum recursion depth (0 to 2, default: 0 - record in coverage only)
SUBMODULE_MAX_DEPTH=0

# Maximum Node.js heap bytes before degrading to partial analysis coverage (default: 536870912 / 512MB)
MAX_HEAP_BYTES=536870912

# ------------------------------------------------------------------------------
# 6. Observability, Metrics & Telemetry
# ------------------------------------------------------------------------------
# Logging level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# Secret bearer token protecting the Prometheus metrics endpoint (/api/metrics)
# Example: curl -H "Authorization: Bearer <METRICS_BEARER_TOKEN>" http://localhost:3000/api/metrics
METRICS_BEARER_TOKEN=

# Optional Sentry DSN for error telemetry (sensitive request fields are scrubbed)
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 7. Security Headers & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin /api/* requests.
# Leave empty to disallow cross-origin API access by default.
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 8. Phase 3 Scaling Foundations (Feature Flags)
# ------------------------------------------------------------------------------
# Enable incremental analysis using GitHub Compare API (default: false)
INCREMENTAL_ANALYSIS_ENABLED=false

# ------------------------------------------------------------------------------
# 9. AI Explanation Layer (Optional Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_INPUT_CHARS=60000
GROQ_ENABLED=true
