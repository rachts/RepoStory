{
  "name": "repo-story",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "next start",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/component --exclude \"**/*msw*\" --exclude \"**/truncated-trees*\"",
    "test:integration": "vitest run tests/unit/github-resilience-msw.test.ts tests/unit/truncated-trees.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:worker-crash": "tsx scripts/verify-worker-crash.ts"
  },
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@sentry/nextjs": "^11.11.0",
    "@upstash/ratelimit": "^2.2.0",
    "@xyflow/react": "^12.12.0",
    "groq-sdk": "^1.6.0",
    "next": "16.4.2",
    "next-auth": "^4.24.15",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tar-stream": "3.2.2",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
